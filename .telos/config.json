{
  "version": 2,
  "stack": [
    "javascript"
  ],
  "checks": {
    "test": "node --test --test-reporter=dot test/*.test.mjs",
    "e2e": "node --test test/e2e-*.test.mjs"
  },
  "limits": {
    "status_lines": 40,
    "map_tokens": 600,
    "area_tokens": 800,
    "history_entries": 30
  },
  "git": {
    "auto_commit": true,
    "phase_tags": true
  },
  "files_language": "en"
}
