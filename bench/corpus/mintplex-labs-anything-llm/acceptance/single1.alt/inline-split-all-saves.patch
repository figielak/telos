+/** Split an OpenAI message content (string or parts array) into the prompt text and image attachments. */
+function splitContent(content) {
+  if (!Array.isArray(content)) return { prompt: content, attachments: [] };
+  const prompt = content.filter((p) => p?.type === "text").map((p) => p.text).join("\n");
+  const attachments = content
+    .filter((p) => p?.type === "image_url")
+    .map((p, n) => {
+      const url = p.image_url?.url ?? "";
+      const mime = /^data:([^;,]+);base64,/i.exec(url)?.[1]?.toLowerCase() ?? "image/png";
+      return { name: `uploaded_image_${n}`, mime, contentString: url };
+    });
+  return { prompt, attachments };
+}
