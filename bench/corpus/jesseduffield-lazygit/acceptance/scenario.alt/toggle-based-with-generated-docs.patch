diff --git a/pkg/gui/filetree/collapse_all.go b/pkg/gui/filetree/collapse_all.go
new file mode 100644
index 00000000..2eb80fc1
--- /dev/null
+++ b/pkg/gui/filetree/collapse_all.go
@@ -0,0 +1,24 @@
+package filetree
+
+import "strings"
+
+type pathNode interface {
+	IsFile() bool
+	GetPath() string
+}
+
+// setAllDirsCollapsed brings every directory among `nodes` into the given state and reports whether it changed any.
+func setAllDirsCollapsed[N pathNode](nodes []N, paths *CollapsedPaths, collapsed bool) bool {
+	changed := false
+	for _, node := range nodes {
+		if !node.IsFile() && paths.IsCollapsed(node.GetPath()) != collapsed {
+			paths.ToggleCollapsed(node.GetPath())
+			changed = true
+		}
+	}
+	return changed
+}
+
+func topLevelDir(path string) string {
+	return strings.Split(path, "/")[0]
+}
