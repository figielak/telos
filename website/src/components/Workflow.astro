---
const TOKENS = /(telos lint-plan|telos accept|git reset --hard|git add -A|git add \.|git push|--no-verify|strict_scope: true|git\.auto_commit|\/telos:undo|\.telos\/)/g;
/** Static copy only: wraps commands in <code> so they never break across lines. */
const code = (s: string) => s.replace(TOKENS, '<code class="font-mono text-[0.92em] whitespace-nowrap text-text">$1</code>');

const stages = [
  {
    name: 'Plan',
    cmd: '/telos:plan',
    body: 'Telos writes draft task files, each with a scope and acceptance items, and fixes them until telos lint-plan passes. You get a short summary.',
  },
  {
    name: 'Approve',
    cmd: '/telos:approve',
    body: 'Approval refuses a plan with lint problems and keeps tasks with unconfirmed decisions in draft. The rest become approved, the plan is committed and a local tag marks the start.',
  },
  {
    name: 'Implement',
    cmd: '/telos:do',
    body: 'Telos writes the tests first, then the implementation. After two failed fix attempts the task is marked blocked instead of guessing further.',
  },
  {
    name: 'Verify',
    cmd: 'telos accept',
    body: 'Runs the task’s command items and checks that every changed file is inside its scope or listed as a deviation. When git.auto_commit is true, a passing task is committed on its own; otherwise Telos lists the paths and the subject.',
  },
];
---

<section id="workflow" class="border-t border-line">
  <div class="section-y mx-auto max-w-page px-4 sm:px-6">
    <div class="flex max-w-[40rem] flex-col items-start gap-5">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">Workflow</p>
      <h2 class="text-3xl font-semibold text-balance md:text-5xl">From plan to commit, one task at a time.</h2>
      <p class="text-muted" set:html={code('Every /telos:* skill is user-invoked: nothing runs until you call it. Telos does not push; its git guard blocks git push.')} />
    </div>
    <ol class="m-0 mt-12 grid list-none gap-10 p-0 lg:mt-16 lg:grid-cols-4 lg:gap-0">
      {stages.map((s, i) => (
        <li class="relative border-l border-line pl-6 lg:border-t lg:border-l-0 lg:pt-8 lg:pr-8 lg:pl-0">
          <span
            class="absolute top-1 -left-1.5 size-2.5 rounded-full bg-accent lg:-top-1.5 lg:left-0"
            aria-hidden="true"></span>
          <p class="m-0 font-mono text-xs text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 text-2xl font-semibold">{s.name}</h3>
          <p class="m-0 mt-1 font-mono text-sm text-accent">{s.cmd}</p>
          <p class="mt-4 max-w-[34ch] text-sm leading-relaxed text-muted" set:html={code(s.body)} />
        </li>
      ))}
    </ol>
  </div>
</section>
