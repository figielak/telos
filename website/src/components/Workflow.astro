---
const TOKENS = /(telos lint-plan|telos accept|git reset --hard|git add -A|git add \.|git push|--no-verify|strict_scope: true|git\.auto_commit|\/telos:undo|\.telos\/)/g;
/** Static copy only: wraps commands in <code> so they never break across lines. */
const code = (s: string) => s.replace(TOKENS, '<code class="font-mono text-[0.92em] whitespace-nowrap text-text">$1</code>');

const stages = [
  {
    name: 'Plan',
    cmd: '/telos:plan',
    body: 'Describe what you need. Get draft tasks with clear boundaries and acceptance criteria.',
  },
  {
    name: 'Approve',
    cmd: '/telos:approve',
    body: 'Review the tasks and resolve open decisions before implementation begins.',
  },
  {
    name: 'Implement',
    cmd: '/telos:do',
    body: 'Telos writes tests first, then implements the approved task. Work stops after two failed fix attempts.',
  },
  {
    name: 'Verify',
    cmd: 'telos accept',
    body: 'Check the result against the task. When auto-commit is enabled, passing work gets its own commit.',
  },
];
---

<section id="workflow" class="border-t border-line">
  <div class="section-y mx-auto max-w-page px-4 sm:px-6">
    <div class="flex max-w-[40rem] flex-col items-start gap-5">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">Workflow</p>
      <h2 class="text-3xl font-semibold text-balance md:text-5xl">From plan to commit, one task at a time.</h2>
      <p class="text-muted" set:html={code('Every skill is user-invoked. You choose the next step. Telos does not push.')} />
    </div>
    <ol class="m-0 mt-12 grid list-none gap-10 p-0 lg:mt-16 lg:grid-cols-4 lg:gap-0">
      {stages.map((s, i) => (
        <li class="relative border-l border-line pl-6 lg:border-t lg:border-l-0 lg:pt-8 lg:pr-8 lg:pl-0">
          <span
            class="absolute top-1 -left-1.5 size-2.5 rounded-full bg-accent lg:-top-1.5 lg:left-0"
            aria-hidden="true"></span>
          <p class="m-0 font-mono text-xs text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 text-2xl font-semibold">{s.name}</h3>
          <p class="m-0 mt-1 font-mono text-sm text-accent">{s.cmd}</p>
          <p class="mt-4 max-w-[34ch] text-sm leading-relaxed text-muted" set:html={code(s.body)} />
        </li>
      ))}
    </ol>

    <figure data-task-example class="m-0 mt-12 overflow-hidden rounded-md border border-line bg-surface lg:mt-16">
      <figcaption class="border-b border-line px-6 py-4 text-sm text-muted md:px-8">
        <span class="text-accent">One request, made concrete.</span> Illustrative example in a sample repository.
      </figcaption>
      <div class="grid lg:grid-cols-[0.85fr_1.15fr]">
        <div class="flex flex-col justify-between gap-8 p-6 md:p-8">
          <div>
            <p class="font-mono text-xs tracking-widest text-muted uppercase">01 / Your request</p>
            <blockquote class="m-0 mt-4 max-w-[24ch] font-display text-2xl font-medium text-balance md:text-3xl">
              “Add a greeting helper with tests.”
            </blockquote>
          </div>
          <p class="max-w-[38ch] text-sm text-muted">A small change, with an explicit boundary and an outcome you can check before moving on.</p>
        </div>
        <div class="min-w-0 border-t border-line p-6 md:p-8 lg:border-t-0 lg:border-l">
          <p class="font-mono text-xs tracking-widest text-accent uppercase">02 / Approved task · 01-01</p>
          <dl class="mt-5 grid gap-5 text-sm">
            <div>
              <dt class="font-semibold">Scope</dt>
              <dd class="m-0 mt-1 font-mono text-muted">src/greet.mjs<br />test/greet.test.mjs</dd>
            </div>
            <div>
              <dt class="font-semibold">Acceptance</dt>
              <dd class="m-0 mt-1 text-muted"><code>greet('Ada')</code> returns <code>“Hello, Ada!”</code>.<br /><code>npm test</code> exits 0.</dd>
            </div>
          </dl>
          <div class="mt-6 border-t border-line pt-5">
            <p class="font-mono text-xs tracking-widest text-accent uppercase">03 / Checked commit</p>
            <p class="mt-3 font-mono text-sm text-muted">npm test → exit 0<br />telos accept 01-01 → PASS</p>
            <p class="mt-3 font-mono text-sm break-words text-text">feat(01-01): add greeting helper</p>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>
