---
const tree = `.telos/
  config.json         profile, stack, checks
  PROJECT.md          project, its rules      ≤ 60 lines
  MAP.md              where things are        ≈ 1500 tokens
  ROADMAP.md          phases and status       ≤ 80 lines
  STATUS.md           now, next, blockers     ≤ 40 lines
  HISTORY.md          decisions, delete-zone  standard+
  LESSONS.md          lessons learned         standard+, max 20
  decisions/          ADR-lite files          deep
  phases/
    01-name/
      01-CONTEXT.md   phase goal              standard+
      01-RESEARCH.md  research                deep
      01-01-slug.md   one task file
  .cache/             gitignored scratch`;

const homes = [
  ['What is this project and which rules apply?', 'PROJECT.md'],
  ['Where is X in the code?', 'MAP.md'],
  ['What is in progress, next or blocked?', 'STATUS.md'],
  ['Why was X decided, removed or reverted?', 'HISTORY.md, decisions/'],
  ['How exactly is this task done?', 'the task file'],
  ['What changed in the code?', 'git'],
];
---

<section id="memory" class="border-t border-line">
  <div class="section-y mx-auto grid max-w-page gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="flex min-w-0 flex-col gap-8">
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-xs tracking-widest text-accent uppercase">Project memory</p>
        <h2 class="text-3xl font-semibold text-balance md:text-5xl">One home for every fact.</h2>
        <p class="max-w-[40rem] text-muted">
          Telos keeps its memory as plain files in your repository: nothing is hosted and nothing is
          written twice. Skills read only the files a step needs.
        </p>
      </div>
      <dl class="m-0">
        {homes.map(([q, a]) => (
          <div class="grid gap-1 border-t border-line py-4 first:border-t-0 first:pt-0 sm:grid-cols-[1fr_auto] sm:gap-6">
            <dt class="text-sm text-muted">{q}</dt>
            <dd class="m-0 font-mono text-sm text-text">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
    <figure class="m-0 min-w-0">
      <div class="rounded-md border border-line bg-surface">
        <div class="border-b border-line px-4 py-2.5 font-mono text-xs tracking-widest text-muted uppercase">
          Your repository
        </div>
        <div
          role="region"
          aria-label="The .telos directory tree"
          tabindex="0"
          class="overflow-x-auto p-4 md:p-5"
        >
          <pre class="m-0 w-max min-w-full font-mono text-[0.8125rem] leading-6 text-muted md:text-sm md:leading-7"><code>{tree}</code></pre>
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-xs text-muted">
        Files marked standard+ or deep exist only in those profiles.
      </figcaption>
    </figure>
  </div>
</section>
