---
import Monogram from './Monogram.astro';

interface Props {
  current?: 'home' | 'docs';
}
const { current = 'home' } = Astro.props;
const GITHUB = 'https://github.com/figielak/telos';
// Guide pages reach the landing sections through /#section; the landing page keeps in-page anchors.
const anchor = current === 'docs' ? '/#' : '#';
const links = [
  { href: `${anchor}workflow`, label: 'Workflow' },
  { href: `${anchor}features`, label: 'Features' },
  { href: `${anchor}memory`, label: 'Project memory' },
  { href: `${anchor}profiles`, label: 'Profiles' },
  { href: `${anchor}getting-started`, label: 'Getting started' },
  { href: '/docs/', label: 'Guide', page: 'docs' },
];
const linkClass =
  'rounded-sm px-1 py-2 font-display text-sm font-medium text-muted transition-colors duration-300 hover:text-text';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-semibold tracking-tight text-text">
      <Monogram size={26} class="text-accent" />
      Telos
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {links.map((l) => <a href={l.href} class={linkClass} aria-current={l.page === current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={GITHUB} class={`${linkClass} px-3 text-text`}>GitHub</a>
      <details id="mobile-menu" class="group relative lg:hidden">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-sm border border-line px-4 font-display text-sm font-medium text-text marker:hidden [&::-webkit-details-marker]:hidden"
        >
          Menu
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false" class="transition-transform duration-300 group-open:rotate-180">
            <path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </summary>
        <nav aria-label="Primary, small screens" class="absolute right-0 mt-2 flex w-64 flex-col rounded-md border border-line bg-surface p-2">
          {links.map((l) => <a href={l.href} class={`${linkClass} px-3`} aria-current={l.page === current ? 'page' : undefined}>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.getElementById('mobile-menu');
    menu.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
        const heading = document.getElementById(link.hash.slice(1))?.querySelector('h2');
        if (heading) {
          heading.setAttribute('tabindex', '-1');
          requestAnimationFrame(() => heading.focus({ preventScroll: true }));
        }
      });
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary').focus();
      }
    });
  })();
</script>
