---
import Terminal from './Terminal.astro';
const GITHUB = 'https://github.com/figielak/telos';
---

<section class="section-y">
  <div class="mx-auto flex max-w-page flex-col items-center px-4 text-center sm:px-6">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">PURPOSE-BUILT FOR CLAUDE CODE</p>
    <h1 class="mt-6 text-4xl font-semibold text-balance md:text-6xl">From intent to completion.</h1>
    <p class="mt-6 max-w-[40rem] text-base text-balance text-muted md:text-lg">
      Plan, approve, implement, verify. A lightweight workflow that keeps you in control.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="#getting-started"
        class="inline-flex min-h-12 items-center rounded-sm bg-accent px-6 font-display text-sm font-semibold text-bg transition-transform duration-200 hover:brightness-110 active:translate-y-px"
      >
        Get started
      </a>
      <a
        href={GITHUB}
        class="inline-flex min-h-12 items-center rounded-sm border border-line px-6 font-display text-sm font-semibold text-text transition-colors duration-300 hover:border-accent active:translate-y-px"
      >
        View on GitHub
      </a>
    </div>
    <p class="mt-4 font-mono text-xs text-muted">Pre-alpha. Requires Claude Code, Git and Node.js ≥ 20.10.</p>
    <div class="mt-10 w-full max-w-[60rem] min-w-0 md:mt-12">
      <Terminal />
    </div>
  </div>
</section>
