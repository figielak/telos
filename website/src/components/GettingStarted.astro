---
import Meander from './Meander.astro';

const commands = [
  '/plugin marketplace add figielak/telos',
  '/plugin install telos@telos',
  '/telos:init standard',
];
const requirements = ['Claude Code with plugin support', 'Git', 'Node.js ≥ 20.10'];
const steps = [
  ['/telos:plan', 'Describe a phase and get draft tasks.'],
  ['/telos:approve', 'Review the plan and approve it.'],
  ['/telos:do', 'Run the next approved task.'],
];
---

<section id="getting-started" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:py-32">
    <div class="flex flex-col items-start gap-6 md:sticky md:top-28 md:self-start">
      <Meander uid="meander-start" class="w-24 text-accent" />
      <p class="font-mono text-xs tracking-widest text-accent uppercase">Getting started</p>
      <h2 class="text-3xl font-semibold md:text-5xl">Three commands to begin.</h2>
      <p class="max-w-[44ch] text-muted">
        Telos is set up per repository. Run these inside Claude Code, in the repository you want to use it in.
      </p>
      <ul class="m-0 flex list-none flex-col gap-1 p-0 font-mono text-xs text-muted">
        <li>Requires:</li>
        {requirements.map((r) => <li class="text-text">{r}</li>)}
      </ul>
    </div>

    <div class="flex min-w-0 flex-col gap-12">
      <div>
        <ol class="m-0 flex list-none flex-col gap-3 p-0">
          {commands.map((c, i) => (
            <li class="flex items-center justify-between gap-3 rounded-md border border-line bg-surface py-2 pr-2 pl-4">
              <span class="font-mono text-xs text-muted" aria-hidden="true">{i + 1}</span>
              <code class="min-w-0 flex-1 overflow-x-auto py-1.5 font-mono text-sm whitespace-nowrap text-text select-all">{c}</code>
              <button
                type="button"
                hidden
                data-copy={c}
                aria-label={`Copy ${c}`}
                class="min-h-10 shrink-0 cursor-pointer rounded-sm border border-line px-4 font-display text-sm font-semibold text-text transition-colors duration-300 hover:border-accent active:translate-y-px"
              >
                Copy
              </button>
            </li>
          ))}
        </ol>
        <p id="copy-status" aria-live="polite" class="mt-3 min-h-6 font-mono text-xs text-accent"></p>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-xl font-semibold md:text-2xl">Then, in order</h3>
        <ol class="m-0 list-none p-0">
          {steps.map(([cmd, text]) => (
            <li class="grid gap-1 border-t border-line py-4 first:border-t-0 first:pt-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <code class="font-mono text-sm text-accent">{cmd}</code>
              <span class="text-muted">{text}</span>
            </li>
          ))}
        </ol>
        <p class="max-w-[60ch] text-sm text-muted">
          In an existing repository, run <code class="font-mono text-text">/telos:map</code> first to build the
          map of where things are.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    if (!navigator.clipboard || !window.isSecureContext) return;
    const status = document.getElementById('copy-status');
    let timer;
    const say = (text) => {
      status.textContent = text;
      clearTimeout(timer);
      timer = setTimeout(() => { status.textContent = ''; }, 2500);
    };
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy);
          say('Copied: ' + b.dataset.copy);
        } catch {
          say('Copy failed. Select the command and copy it by hand.');
        }
      });
    });
  })();
</script>
