---
// Greek capital tau in a thin circle. Decorative; color comes from the parent (currentColor).
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
  <path d="M10.5 11h11M16 11v10.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
</svg>
