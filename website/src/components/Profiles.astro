---
import { columns, rows } from '../data/profiles.mjs';
const guidance = [
  { audience: 'For small projects and focused experiments.', benefit: 'The core plan-to-commit loop, with a lean set of project files.' },
  { audience: 'For ongoing projects you return to across sessions.', benefit: 'Adds shared decisions, lessons and scope checks to the core workflow.' },
  { audience: 'For complex work that needs more investigation and review.', benefit: 'Adds research, code review and stricter verification for critical tasks.' },
];
---

<section id="profiles" class="border-t border-line">
  <div class="section-y mx-auto flex max-w-page flex-col gap-12 px-4 sm:px-6 lg:gap-16">
    <div class="flex max-w-[40rem] flex-col items-start gap-5">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">Profiles</p>
      <h2 class="text-3xl font-semibold text-balance md:text-5xl">Start small. Add rigor when you need it.</h2>
      <p class="text-muted">
        Each profile is a superset of the previous one. Pick one with <code class="font-mono text-text">/telos:init</code>{' '}
        and change it any time with <code class="font-mono text-text">/telos:profile</code>.
        Start with Standard if you’re unsure.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {columns.map((c, i) => (
        <article class:list={["rounded-md border bg-surface p-6 md:p-8", c === "standard" ? "border-accent" : "border-line"]}>
          <p class="mb-3 font-mono text-xs text-accent">{c === 'standard' ? 'Recommended start' : c === 'minimal' ? 'Core workflow' : 'Additional rigor'}</p>
          <h3 class="m-0 text-xl font-semibold capitalize md:text-2xl">{c}</h3>
          <p class="mt-4 text-text">{guidance[i].audience}</p>
          <p class="mt-3 text-sm text-muted">{guidance[i].benefit}</p>
          <details class="mt-6 border-t border-line pt-4">
            <summary class="cursor-pointer py-2 text-sm text-accent">Full comparison<span class="sr-only">: {c}</span></summary>
            <dl class="m-0 mt-3">
              {rows.map((r) => (
                <div class="grid gap-1 border-t border-line py-4">
                  <dt class="font-mono text-xs tracking-widest text-muted uppercase">{r.label}</dt>
                  <dd class="m-0 text-sm leading-relaxed text-text">{r.cells[i]}</dd>
                </div>
              ))}
            </dl>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>
