---
import { columns, rows } from '../data/profiles.mjs';
---

<section id="profiles" class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 sm:px-6 md:gap-16 md:py-32">
    <div class="grid gap-6 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
      <div class="flex flex-col items-start gap-6">
        <p class="font-mono text-xs tracking-widest text-accent uppercase">Profiles</p>
        <h2 class="text-3xl font-semibold md:text-5xl">Start small. Add rigor when you need it.</h2>
      </div>
      <p class="max-w-[56ch] self-end text-muted">
        Each profile is a superset of the previous one. Pick one with <code class="text-text">/telos:init</code>{' '}
        and change it any time with <code class="text-text">/telos:profile</code>. Commands outside the current
        profile reply with a single line naming the profile they need.
      </p>
    </div>

    <table role="table" class="ptable w-full border-collapse text-left">
      <caption class="sr-only">What each Telos profile includes</caption>
      <thead role="rowgroup">
        <tr role="row" class="border-b border-line">
          <th scope="col" role="columnheader" class="w-36 py-4 pr-4 font-mono text-xs tracking-widest text-muted uppercase">Area</th>
          {columns.map((c) => (
            <th scope="col" role="columnheader" class="py-4 pr-6 font-display text-lg font-semibold text-text capitalize">{c}</th>
          ))}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map((r) => (
          <tr role="row" class="border-b border-line">
            <th scope="row" role="rowheader" class="py-5 pr-4 align-top font-mono text-xs tracking-widest text-accent uppercase">{r.label}</th>
            {r.cells.map((cell, i) => (
              <td role="cell" data-label={columns[i]} class="py-5 pr-6 align-top text-sm leading-relaxed text-muted">{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  @media (max-width: 47.999rem) {
    .ptable,
    .ptable tbody,
    .ptable tr,
    .ptable th,
    .ptable td {
      display: block;
    }
    .ptable thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ptable tr {
      padding: 1.5rem 0;
    }
    .ptable th[scope='row'] {
      padding: 0 0 0.75rem;
    }
    .ptable td {
      padding: 0.5rem 0;
    }
    .ptable td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text);
    }
  }
</style>
