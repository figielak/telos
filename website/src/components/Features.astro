---
const TOKENS = /(telos lint-plan|telos accept|git reset --hard|git add -A|git add \.|git push|--no-verify|strict_scope: true|git\.auto_commit|\/telos:undo|\.telos\/)/g;
/** Static copy only: wraps commands in <code> so they never break across lines. */
const code = (s: string) => s.replace(TOKENS, '<code class="font-mono text-[0.92em] whitespace-nowrap text-text">$1</code>');

const rows = [
  {
    cols: 'lg:grid-cols-[1.35fr_0.65fr]',
    items: [
      {
        title: 'You stay in control',
        body: 'Agree on the work before it starts. Review the plan, approve its scope and see when a change reaches beyond it.',
        detail: 'Skills are user-invoked, and no task starts before you approve the plan. In the standard and deep profiles an edit outside the running task’s scope adds a warning, or is blocked with strict_scope: true. /telos:undo lists the exact commits and dependent tasks, asks once, then reverts newest first.',
      },
      {
        title: 'Memory between sessions',
        body: 'Resume work with the project’s rules, decisions and next task already available. The memory lives alongside your code.',
        detail: 'Plain files in .telos/ hold the rules, map, roadmap and status. Each skill reads one context bundle of at most 6000 characters, and the SessionStart status stays within 1200.',
      },
    ],
  },
  {
    cols: 'lg:grid-cols-[0.65fr_1.35fr]',
    items: [
      {
        title: 'Tests define done',
        body: 'Give each task a checkable outcome. Tests come before implementation, and acceptance checks show what passed and what still needs attention.',
        detail: 'Every task lists acceptance items. telos lint-plan rejects files outside the scope and acceptance with no command to run, implementation starts with tests first, and telos accept runs each command item and compares every changed file with the scope.',
      },
      {
        title: 'A commit you can review',
        body: 'Follow a completed task from its agreed scope to its changes in Git. Separate commits make that work easier to inspect or undo.',
        detail: 'Each task is committed on its own, with explicit paths, when git.auto_commit is true. A git guard blocks git push, --no-verify, git add -A and git add ., git reset --hard, and amending a commit already on a remote branch.',
      },
    ],
  },
];
---

<section id="features" class="border-t border-line">
  <div class="section-y mx-auto max-w-page px-4 sm:px-6">
    <div class="flex max-w-[40rem] flex-col items-start gap-5">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">Core features</p>
      <h2 class="text-3xl font-semibold text-balance md:text-5xl">Control, memory, tests, commits.</h2>
      <p class="text-muted">
        Less context to repeat. A clearer boundary for every change.
      </p>
    </div>
    <div class="mt-12 flex flex-col gap-10 lg:mt-16 lg:gap-14">
      {rows.map((row) => (
        <div class={`grid gap-10 lg:gap-14 ${row.cols}`}>
          {row.items.map((f) => (
            <article class="flex flex-col gap-3 border-t border-line pt-6">
              <h3 class="text-xl font-semibold md:text-2xl">{f.title}</h3>
              <p class="max-w-[60ch] text-muted" set:html={code(f.body)} />
              <details class="group">
                <summary class="w-fit cursor-pointer py-2 text-sm text-accent">How it works<span class="sr-only">: {f.title}</span></summary>
                <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-muted" set:html={code(f.detail)} />
              </details>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
