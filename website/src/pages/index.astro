---
import Base from '../layouts/Base.astro';
import Meander from '../components/Meander.astro';
---

<Base
  title="Telos: From intent to completion"
  description="Telos is a lightweight workflow plugin for Claude Code: plan, approve, implement, test and commit, with project memory kept in your repository."
>
  <section class="mx-auto flex min-h-[100dvh] max-w-6xl flex-col justify-center gap-8 px-4 sm:px-6">
    <Meander class="w-24 text-accent" />
    <h1 class="text-4xl font-semibold md:text-6xl">From intent to completion.</h1>
    <p class="max-w-[65ch] text-muted">Landing page foundation. Sections follow in later tasks.</p>
  </section>
</Base>
