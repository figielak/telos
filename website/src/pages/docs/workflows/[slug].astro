---
import Docs from '../../../layouts/Docs.astro';
import { workflows } from '../../../data/docs/workflows.mjs';

export function getStaticPaths() {
  return workflows.map((w) => ({ params: { slug: w.slug } }));
}
const w = workflows.find((x) => x.slug === Astro.params.slug);
const h2 = 'text-2xl font-semibold md:text-3xl';
const list = 'm-0 mt-4 flex list-none flex-col gap-2 p-0 text-muted';
const label = 'font-mono text-xs tracking-widest text-accent uppercase';
const sections = [
  { id: 'when', label: 'When to choose it' },
  { id: 'start', label: 'Starting state' },
  { id: 'steps', label: 'Steps' },
  { id: 'stops', label: 'Stop conditions' },
  { id: 'alternatives', label: 'Alternatives' },
];
---

<Docs title={`${w.title}: Telos workflow recipe`} description={w.summary}>
  <nav aria-label="Guide" class="mb-8 font-mono text-xs text-muted">
    <a href="/docs/" class="text-accent underline underline-offset-4">Command guide</a>
    <span aria-hidden="true"> / </span>
    <a href="/docs/workflows/" class="text-accent underline underline-offset-4">Workflow recipes</a>
  </nav>

  <div class="lg:grid lg:grid-cols-[14rem_1fr] lg:gap-12">
    <nav aria-label="On this page" class="mb-10 lg:sticky lg:top-24 lg:self-start">
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 lg:flex-col">
        {sections.map((s) => (
          <li><a href={`#${s.id}`} class="inline-block py-1.5 font-display text-sm font-medium text-muted transition-colors duration-300 hover:text-text">{s.label}</a></li>
        ))}
      </ul>
    </nav>

    <article class="min-w-0 max-w-[48rem]">
      <p class={label}>Workflow recipe</p>
      <h1 class="mt-4 text-4xl font-semibold text-balance md:text-5xl">{w.title}</h1>
      <p class="mt-4 text-lg text-muted">{w.summary}</p>
      <p class="mt-4 text-sm text-muted"><span class={label}>Illustrative </span>{w.illustration.replace(/^Illustrative scenario: /, '')}</p>

      <section aria-labelledby="when" class="mt-12">
        <h2 id="when" class={h2}>When to choose it</h2>
        <h3 class="mt-4 text-lg font-semibold">Choose it when</h3>
        <ul class={list}>{w.choose.map((c) => <li>{c}</li>)}</ul>
        <h3 class="mt-6 text-lg font-semibold">Avoid it when</h3>
        <ul class={list}>{w.avoid.map((c) => <li>{c}</li>)}</ul>
      </section>

      <section aria-labelledby="start" class="mt-12">
        <h2 id="start" class={h2}>Starting state</h2>
        <dl class="mt-4 grid gap-4 rounded-md border border-line bg-surface p-5 text-sm">
          <div><dt class={label}>Profile</dt><dd class="m-0 mt-1 text-muted">{w.start.profile}</dd></div>
          <div><dt class={label}>Repository</dt><dd class="m-0 mt-1 text-muted">{w.start.repository}</dd></div>
          <div><dt class={label}>Phase</dt><dd class="m-0 mt-1 text-muted">{w.start.phase}</dd></div>
          <div><dt class={label}>Task</dt><dd class="m-0 mt-1 text-muted">{w.start.task}</dd></div>
        </dl>
        <h3 class="mt-6 text-lg font-semibold">What exists at the end</h3>
        <ul class={list}>{w.artifacts.map((a) => <li>{a}</li>)}</ul>
      </section>

      <section aria-labelledby="steps" class="mt-12">
        <h2 id="steps" class={h2}>Steps</h2>
        <p class="mt-4 text-muted">
          Each step says where to run it: <strong class="font-semibold text-text">Claude Code</strong> is the chat prompt,
          <strong class="font-semibold text-text">Bash</strong> is a terminal in the repository, and
          <strong class="font-semibold text-text">You decide</strong> is your own action. Steps marked conditional apply only when their condition is true.
        </p>
        <ol class="m-0 mt-6 flex list-none flex-col gap-10 p-0">
          {w.steps.map((s, i) => (
            <li>
              <h3 id={`step-${i + 1}`} class="text-xl font-semibold">
                <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')} </span>{s.title}
              </h3>
              <p class="mt-2 font-mono text-xs text-muted">
                Run in: {s.where}{s.optional ? ' · conditional' : ''}
              </p>
              {s.condition && <p class="mt-2 text-sm text-text">{s.condition}.</p>}
              {s.command && (
                <div role="region" aria-label={`Step ${i + 1} command`} tabindex="0" class="mt-3 overflow-x-auto rounded-md border border-line bg-surface p-4">
                  <pre class="m-0 w-max min-w-full font-mono text-sm leading-6"><code>{s.command}</code></pre>
                </div>
              )}
              <p class="mt-3 text-muted"><span class={label}>Outcome </span>{s.outcome}</p>
              <p class="mt-2 text-muted"><span class={label}>Checkpoint </span>{s.checkpoint}</p>
              {s.link && (
                <p class="mt-2 text-sm">
                  <a href={`/docs/commands/${s.link}/`} class="text-accent underline underline-offset-4">Command details</a>
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="stops" class="mt-12">
        <h2 id="stops" class={h2}>Stop conditions</h2>
        <ul class={list}>{w.stops.map((s) => <li>{s}</li>)}</ul>
      </section>

      <section aria-labelledby="alternatives" class="mt-12">
        <h2 id="alternatives" class={h2}>Alternatives</h2>
        <ul class={list}>
          {w.alternatives.map((a) => (
            <li>
              {a.slug ? <a href={`/docs/commands/${a.slug}/`} class="text-accent underline underline-offset-4">{a.label}</a> : <strong class="font-semibold text-text">{a.label}</strong>}
              {' '}— {a.note}
            </li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</Docs>
