---
import Docs from '../../../layouts/Docs.astro';
import { commands, bySlug, kindLabel, sourceUrl } from '../../../data/docs/commands.mjs';

export function getStaticPaths() {
  return commands.map((c) => ({ params: { slug: c.slug } }));
}
const c = bySlug(Astro.params.slug);

const sections = [
  { id: 'what-it-does', label: 'What it does' },
  { id: 'effects', label: 'Effects' },
  { id: 'examples', label: 'Examples' },
  ...(c.variants?.length ? [{ id: 'variants', label: 'Variants' }] : []),
  ...(c.subcommands?.length ? [{ id: 'subcommands', label: 'Subcommands and bundles' }] : []),
  { id: 'when-to-use', label: 'When to use' },
  { id: 'when-to-avoid', label: 'When to avoid' },
  { id: 'alternatives', label: 'Alternatives' },
  { id: 'sources', label: 'Sources' },
];
const h2 = 'text-2xl font-semibold md:text-3xl';
const list = 'm-0 mt-4 flex list-none flex-col gap-2 p-0 text-muted';
---

<Docs title={`${c.name}: Telos command guide`} description={c.summary}>
  <nav aria-label="Guide" class="mb-8 font-mono text-xs text-muted">
    <a href="/docs/" class="text-accent underline underline-offset-4">Command guide</a>
    <span aria-hidden="true"> / </span>{kindLabel(c.kind)}
  </nav>

  <div class="lg:grid lg:grid-cols-[14rem_1fr] lg:gap-12">
    <nav aria-label="On this page" class="mb-10 lg:sticky lg:top-24 lg:self-start">
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 lg:flex-col">
        {sections.map((s) => (
          <li><a href={`#${s.id}`} class="inline-block py-1.5 font-display text-sm font-medium text-muted transition-colors duration-300 hover:text-text">{s.label}</a></li>
        ))}
      </ul>
    </nav>

    <article class="min-w-0 max-w-[48rem]">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">{kindLabel(c.kind)}</p>
      <h1 class="mt-4 text-4xl font-semibold break-words md:text-5xl">{c.name}</h1>
      <p class="mt-4 text-lg text-muted">{c.summary}</p>

      <dl class="mt-8 grid gap-4 rounded-md border border-line bg-surface p-5 text-sm">
        <div>
          <dt class="font-mono text-xs tracking-widest text-accent uppercase">Syntax</dt>
          <dd class="m-0 mt-1 break-words font-mono text-text">{c.invocation}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs tracking-widest text-accent uppercase">Profiles</dt>
          <dd class="m-0 mt-1 text-muted">{c.profiles}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs tracking-widest text-accent uppercase">Prerequisites</dt>
          <dd class="m-0 mt-1">
            <ul class="m-0 flex list-none flex-col gap-1 p-0 text-muted">{c.prerequisites.map((p) => <li>{p}</li>)}</ul>
          </dd>
        </div>
      </dl>

      <section aria-labelledby="what-it-does" class="mt-12">
        <h2 id="what-it-does" class={h2}>What it does</h2>
        {c.explanation.map((p) => <p class="mt-4 text-muted">{p}</p>)}
      </section>

      <section aria-labelledby="effects" class="mt-12">
        <h2 id="effects" class={h2}>Effects</h2>
        <ul class={list}>{c.effects.map((e) => <li>{e}</li>)}</ul>
      </section>

      <section aria-labelledby="examples" class="mt-12">
        <h2 id="examples" class={h2}>Examples</h2>
        {c.examples.map((e, i) => (
          <div class="mt-6">
            <h3 class="text-lg font-semibold">{e.title}</h3>
            <div role="region" aria-label={`Example ${i + 1}: ${e.title}`} tabindex="0" class="mt-3 overflow-x-auto rounded-md border border-line bg-surface p-4">
              <pre class="m-0 w-max min-w-full font-mono text-sm leading-6"><code>{e.command}</code></pre>
            </div>
            <p class="mt-3 text-muted"><span class="font-mono text-xs tracking-widest text-accent uppercase">Outcome </span>{e.outcome}</p>
          </div>
        ))}
      </section>

      {c.variants?.length > 0 && (
        <section aria-labelledby="variants" class="mt-12">
          <h2 id="variants" class={h2}>Variants</h2>
          {c.variants.map((v) => (
            <div class="mt-6">
              <h3 id={`variant-${v.id}`} class="font-mono text-lg font-semibold">{v.name}</h3>
              <p class="mt-2 break-words font-mono text-sm text-text">{v.invocation}</p>
              <p class="mt-2 text-muted">{v.summary}</p>
              <ul class={list}>{v.notes.map((n) => <li>{n}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      {c.subcommands?.length > 0 && (
        <section aria-labelledby="subcommands" class="mt-12">
          <h2 id="subcommands" class={h2}>Subcommands and bundles</h2>
          {c.subcommands.map((s) => (
            <div class="mt-6">
              <h3 id={`sub-${s.id}`} class="font-mono text-lg font-semibold">{s.name}</h3>
              <p class="mt-2 break-words font-mono text-sm text-text">{s.invocation}</p>
              <p class="mt-2 text-muted">{s.summary}</p>
              <ul class={list}>{s.notes.map((n) => <li>{n}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      <section aria-labelledby="when-to-use" class="mt-12">
        <h2 id="when-to-use" class={h2}>When to use</h2>
        <ul class={list}>{c.use.map((u) => <li>{u}</li>)}</ul>
      </section>

      <section aria-labelledby="when-to-avoid" class="mt-12">
        <h2 id="when-to-avoid" class={h2}>When to avoid</h2>
        <ul class={list}>{c.avoid.map((u) => <li>{u}</li>)}</ul>
      </section>

      <section aria-labelledby="alternatives" class="mt-12">
        <h2 id="alternatives" class={h2}>Alternatives</h2>
        <ul class={list}>
          {c.alternatives.map((a) => (
            <li>
              {a.slug ? <a href={`/docs/commands/${a.slug}/`} class="text-accent underline underline-offset-4">{a.label}</a> : <strong class="font-semibold text-text">{a.label}</strong>}
              {' '}— {a.note}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="sources" class="mt-12">
        <h2 id="sources" class={h2}>Sources</h2>
        <p class="mt-4 text-muted">This page is based on these files in the repository.</p>
        <ul class={list}>
          {c.sources.map((s) => (
            <li><a href={sourceUrl(s.path)} class="break-words text-accent underline underline-offset-4">{s.label}</a> <span class="font-mono text-xs">{s.path}</span></li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</Docs>
